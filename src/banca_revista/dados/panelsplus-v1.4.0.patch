+--- Return how much to shrink a panel so it shows at the fixed page-width zoom.
+---
+--- Each panel is rendered at its own best-fit zoom (`canvasFitZoom`), so
+--- small panels end up hugely magnified. Shrinking the render box by
+--- `fixed / fit` shows every panel at the zoom that fits the page width to the
+--- screen; panels too big for that zoom keep fitting (no shrink).
+---
+--- @param rect PPRect|nil Crop rectangle the panel image was rendered from.
+--- @param page number|nil Document page the rectangle belongs to.
+--- @return number|nil factor Shrink factor below 1, or nil for no change.
+function PanelViewer:getFixedZoomShrinkFactor(rect, page)
+    if not rect or self.crop_mode == "none" or self.embedded_source_image then
+        return nil
+    end
+    local document = self.reader_ui and self.reader_ui.document
+    if not document then
+        return nil
+    end
+    local ok, dims = pcall(document.getNativePageDimensions, document, page or self.page)
+    if not ok or not dims or not dims.w or dims.w <= 0 then
+        return nil
+    end
+    local factor = (Screen:getWidth() / dims.w) / canvasFitZoom(rect)
+    if factor >= 1 then
+        return nil
+    end
+    return factor
+end
+
+--- Return the combined render-box shrink (margin crop and fixed zoom) for a panel.
+---
+--- @param image_num integer|nil 1-based panel index (defaults to the current one).
+--- @param is_full_page boolean|nil Explicit full-page flag, for an adjacent page's panel.
+--- @param rect PPRect|nil Explicit crop rectangle, for an adjacent page's panel.
+--- @param page number|nil Page of `rect` when it is not this viewer's page.
+--- @return number|nil factor Multiplier in (0, 1), or nil when no shrink applies.
+function PanelViewer:getPanelShrinkFactor(image_num, is_full_page, rect, page)
+    if not rect then
+        rect = self.image_rects and self.image_rects[image_num or self._images_list_cur or 1]
+    end
+    local margin = self:getMarginShrinkFactorForPanel(image_num, is_full_page)
+    local fixed = self:getFixedZoomShrinkFactor(rect, page)
+    if not margin and not fixed then
+        return nil
+    end
+    return (margin or 1) * (fixed or 1)
+end
+
